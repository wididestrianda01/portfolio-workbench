# The frozen market-data snapshot: retrieved once, local, and never redistributed, together with the
# run manifests and the workbook export derived from it. Ignored by extension as well as by path,
# because every CSV, archive, workbook or columnar file in this tree is either the snapshot or a
# derivative of it, and the accident this prevents is a fetch or an export landing beside the code
# under a name no path rule listed.
.data/
*.csv
*.zip
*.xlsx
*.xls
*.parquet

# Credentials and local overrides.
.env
.env.*

# Python bytecode caches.
__pycache__/
*.pyc

# Tool caches and local environments. Nothing here is a build input, and each is regenerable, so a
# checkout that carries one would only be a checkout whose diff nobody can read.
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
*.egg-info/
